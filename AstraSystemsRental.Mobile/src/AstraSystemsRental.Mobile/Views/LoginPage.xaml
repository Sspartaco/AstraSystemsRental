<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AstraSystemsRental.Mobile"
             x:Class="AstraSystemsRental.Mobile.Views.LoginPage"
             Shell.NavBarIsVisible="False">

    <Grid Background="{StaticResource GradientMesh}">

        <!-- Capa de partículas: va DEBAJO del contenido y con InputTransparent
             para que no intercepte los toques de los campos ni del botón. -->
        <AbsoluteLayout x:Name="ParticleLayer" InputTransparent="True" CascadeInputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="26,70,26,30" Spacing="0">

                <!-- Monograma: la "A" de Astra dentro del orbe de marca, con el
                     anillo orbital detras. El anillo gira al entrar. -->
                <Border x:Name="LogoOrb" Style="{StaticResource BrandOrb}" WidthRequest="76" HeightRequest="76"
                        StrokeShape="RoundRectangle 24" HorizontalOptions="Center" Opacity="0">
                    <Grid>
                        <Path x:Name="LogoRing" Data="{x:Static local:Icons.MonogramRing}"
                              Stroke="#59FFFFFF" StrokeThickness="1.3" Fill="Transparent"
                              HeightRequest="46" WidthRequest="46" Aspect="Uniform" Rotation="-20"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                        <Path Data="{x:Static local:Icons.Monogram}" Stroke="White" StrokeThickness="2.1"
                              Fill="Transparent" HeightRequest="34" WidthRequest="34" Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label x:Name="BrandTitle" Text="AstraSystems" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0,18,0,0" CharacterSpacing="-0.5" Opacity="0">
                    <Label.TextColor>#e7e9f0</Label.TextColor>
                </Label>

                <Label x:Name="BrandSub" Text="Gestión de flota" FontSize="13" Opacity="0"
                       TextColor="{StaticResource ContentMuted}" HorizontalOptions="Center" Margin="0,4,0,30" />

                <Border x:Name="LoginCard" Style="{StaticResource Panel}" Opacity="0" TranslationY="18">
                    <VerticalStackLayout Spacing="16">

                        <Label Text="Bienvenido de nuevo" Style="{StaticResource TitleLabel}" FontSize="21" />
                        <Label Text="Iniciá sesión para continuar" Style="{StaticResource MutedLabel}" Margin="0,-10,0,0" />

                        <VerticalStackLayout Spacing="7">
                            <Label Text="CORREO ELECTRÓNICO" Style="{StaticResource KpiLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Grid ColumnDefinitions="24,*">
                                    <Path Grid.Column="0" Data="{x:Static local:Icons.User}"
                                          Stroke="{StaticResource ContentMuted}" StrokeThickness="1.6"
                                          HeightRequest="17" WidthRequest="17" Aspect="Uniform"
                                          VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Email}" Keyboard="Email"
                                           Placeholder="tu@empresa.com" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="CONTRASEÑA" Style="{StaticResource KpiLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Grid ColumnDefinitions="24,*">
                                    <Path Grid.Column="0" Data="M6 11V8a6 6 0 0 1 12 0v3 M5 11h14v10H5Z"
                                          Stroke="{StaticResource ContentMuted}" StrokeThickness="1.6"
                                          HeightRequest="17" WidthRequest="17" Aspect="Uniform"
                                          VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Password}" IsPassword="True"
                                           Placeholder="••••••••" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding HasError}" BackgroundColor="#150e10" Stroke="#2e161c"
                                StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="22,*">
                                <Path Grid.Column="0" Data="{x:Static local:Icons.Alert}"
                                      Stroke="{StaticResource Danger}" StrokeThickness="1.8"
                                      HeightRequest="16" WidthRequest="16" Aspect="Uniform" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding Error}" TextColor="{StaticResource Danger}"
                                       FontSize="12.5" Margin="6,0,0,0" />
                            </Grid>
                        </Border>

                        <Button Text="Iniciar sesión" Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}"
                                Margin="0,4,0,0" />

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,6,0,2"
                              IsVisible="{Binding CanUseBiometric}">
                            <BoxView Grid.Column="0" HeightRequest="1" Color="#12FFFFFF" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="o" Style="{StaticResource MutedLabel}" FontSize="11" />
                            <BoxView Grid.Column="2" HeightRequest="1" Color="#12FFFFFF" VerticalOptions="Center" />
                        </Grid>

                        <Button Command="{Binding BiometricCommand}" IsVisible="{Binding CanUseBiometric}"
                                IsEnabled="{Binding IsNotBusy}" Style="{StaticResource GhostButton}"
                                ContentLayout="Left,10" ImageSource="tab_face.png"
                                Text="{Binding BiometricLabel, StringFormat='Entrar con {0}'}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           HeightRequest="22" />

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="Footer" Spacing="7" Margin="0,26,0,0" Opacity="0">
                    <Label Text="Plataforma de gestión de flota" Style="{StaticResource MutedLabel}"
                           FontSize="11" HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5" HorizontalOptions="Center">
                        <Label Grid.Column="0" Text="created by" FontSize="10.5" VerticalOptions="Center"
                               TextColor="{StaticResource ContentFaint}" />
                        <Label Grid.Column="1" Text="codalea" FontSize="11" FontAttributes="Bold"
                               VerticalOptions="Center" CharacterSpacing="0.6"
                               TextColor="{StaticResource BrandBright}" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
