<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AstraSystemsRental.Mobile"
             xmlns:vm="clr-namespace:AstraSystemsRental.Mobile.ViewModels"
             x:Class="AstraSystemsRental.Mobile.Views.RoutinesPage"
             Title="Rutinas de Mantenimiento">

    <Grid Background="{StaticResource GradientMesh}">

        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="10">

                    <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="13"
                           IsVisible="{Binding HasError}" />

                    <Border Style="{StaticResource Panel}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="12" Padding="0,22">
                            <Border Style="{StaticResource IconBadge}" WidthRequest="58" HeightRequest="58"
                                    StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                                <Path Data="{x:Static local:Icons.Routine}" Stroke="{StaticResource BrandBright}"
                                      StrokeThickness="1.7" Fill="Transparent" HeightRequest="26" WidthRequest="26"
                                      Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Todavía no tenés rutinas" FontAttributes="Bold" FontSize="15"
                                   HorizontalOptions="Center" />
                            <Label HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedLabel}" FontSize="12.5" Margin="20,0"
                                   Text="Las rutinas definen cada cuántos kilómetros toca mantenimiento. Se crean desde la web y aparecen acá." />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding Description}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>
