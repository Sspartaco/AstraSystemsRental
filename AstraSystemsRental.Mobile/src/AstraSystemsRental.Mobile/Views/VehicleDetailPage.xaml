<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AstraSystemsRental.Mobile"
             x:Class="AstraSystemsRental.Mobile.Views.VehicleDetailPage"
             Title="{Binding Plate}">

    <Grid Background="{StaticResource GradientMesh}">

        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Border Style="{StaticResource Panel}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Plate}" Style="{StaticResource TitleLabel}" />
                            <Label Text="{Binding Detail}" Style="{StaticResource SubtitleLabel}" />
                            <Label Text="{Binding Status}" FontSize="12"
                                   TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="KILOMETRAJE" Style="{StaticResource MutedLabel}" FontSize="10" />
                                <Label Text="{Binding CurrentMileage}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="PRÓXIMO MTTO." Style="{StaticResource MutedLabel}" FontSize="10" />
                                <Label Text="{Binding NextThreshold}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="RUTINA ASIGNADA" Style="{StaticResource MutedLabel}" FontSize="10" />
                            <Label Text="{Binding RoutineName}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="13"
                           IsVisible="{Binding HasError}" />

                    <Label Text="{Binding SaveMessage}" TextColor="{StaticResource Accent}" FontSize="13"
                           IsVisible="{Binding HasSaveMessage}" />

                    <!-- Tarjeta de completitud: da una razón visible para abrir la
                         ficha. Un botón suelto no dice cuánto falta. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowEdit, Converter={StaticResource InverseBool}}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                    <Path Data="{x:Static local:Icons.Check}" Stroke="{StaticResource BrandBright}"
                                          StrokeThickness="2" HeightRequest="16" WidthRequest="16" Aspect="Uniform"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Ficha del vehículo" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding CompletionHint}" Style="{StaticResource MutedLabel}" FontSize="11.5" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding CompletionLabel}" FontSize="11"
                                       TextColor="{StaticResource ContentMuted}" VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding CompletionProgress}"
                                         ProgressColor="{StaticResource BrandBright}" HeightRequest="3" />

                            <Button Text="Completar ficha" Command="{Binding ToggleEditCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="40" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Misma idea que el asistente web, pero en una sola hoja: en el
                         telefono, tres pasos para datos opcionales es fricción pura. -->
                    <Border x:Name="EditSheet" Style="{StaticResource Panel}" IsVisible="{Binding ShowEdit}">
                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                    <Path Data="{x:Static local:Icons.Truck}" Fill="{StaticResource BrandBright}"
                                          HeightRequest="17" WidthRequest="17" Aspect="Uniform"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Plate}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="Todo es opcional. Guardá lo que tengas."
                                           Style="{StaticResource MutedLabel}" FontSize="11.5" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="✕" Command="{Binding ToggleEditCommand}"
                                        Style="{StaticResource GhostButton}" WidthRequest="40" HeightRequest="40"
                                        FontSize="15" Padding="0" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#12FFFFFF" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Path Grid.Column="0" Data="{x:Static local:Icons.Truck}" Fill="{StaticResource ContentMuted}"
                                      HeightRequest="13" WidthRequest="13" Aspect="Uniform" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="IDENTIFICACIÓN" Style="{StaticResource MutedLabel}"
                                       FontSize="10" CharacterSpacing="1" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Border Grid.Column="0" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding Brand}" Placeholder="Marca" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding Line}" Placeholder="Línea" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Border Grid.Column="0" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding ModelYear}" Placeholder="Modelo (año)" Keyboard="Numeric" MaxLength="4" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding VehicleClass}" Placeholder="Clase" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Path Grid.Column="0" Data="{x:Static local:Icons.Wrench}" Stroke="{StaticResource ContentMuted}"
                                      StrokeThickness="1.7" Fill="Transparent" HeightRequest="13" WidthRequest="13"
                                      Aspect="Uniform" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="CONFIGURACIÓN TÉCNICA" Style="{StaticResource MutedLabel}"
                                       FontSize="10" CharacterSpacing="1" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Border Grid.Column="0" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding BodyType}" Placeholder="Carrocería" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding Color}" Placeholder="Color" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Border Grid.Column="0" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding FuelType}" Placeholder="Combustible" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource InputShell}">
                                    <Entry Text="{Binding Transmission}" Placeholder="Transmisión" />
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource InputShell}">
                                <Entry Text="{Binding ServiceType}" Placeholder="Servicio" />
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Path Grid.Column="0" Data="{x:Static local:Icons.Routine}" Stroke="{StaticResource ContentMuted}"
                                      StrokeThickness="1.7" Fill="Transparent" HeightRequest="13" WidthRequest="13"
                                      Aspect="Uniform" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="NUMERACIÓN" Style="{StaticResource MutedLabel}"
                                       FontSize="10" CharacterSpacing="1" VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource InputShell}">
                                <Entry Text="{Binding Vin}" Placeholder="VIN" />
                            </Border>

                            <Border Style="{StaticResource InputShell}">
                                <Entry Text="{Binding EngineNumber}" Placeholder="Número de motor" />
                            </Border>

                            <Border Style="{StaticResource InputShell}">
                                <Entry Text="{Binding Notes}" Placeholder="Notas" />
                            </Border>

                            <Button Text="Guardar ficha" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}"
                                    Margin="0,4,0,0" />

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Historial de recorrido" FontAttributes="Bold" Margin="0,8,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Readings}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label FontAttributes="Bold" Text="{Binding Value, StringFormat='{0:N0} km'}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding ReadingDate}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Source}" Style="{StaticResource MutedLabel}"
                                               FontSize="11" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>
