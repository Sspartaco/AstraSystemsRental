<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cada plataforma solo declara el target que puede compilar:
           Windows/Linux -> android   (no existe el toolchain de Apple)
           macOS         -> ios       (la Mac de este repo solo compila iOS)
         En macOS se omite android a proposito: el restore evalua TODOS los
         target frameworks, asi que con android declarado falla con NETSDK1147
         pidiendo su workload, aunque el build pida solo -f net10.0-ios.
         Para compilar android en una Mac que si tenga ese workload:
           dotnet build ... -p:IncludeAndroidTarget=true
         Ojo: esto NO se puede resolver pasando -p:TargetFrameworks por linea
         de comandos. Seria una propiedad global, se propagaria a los proyectos
         referenciados y rompe AstraSystemsRental.Contracts con NETSDK1005. -->
    <IncludeAndroidTarget Condition="'$(IncludeAndroidTarget)' == '' And !$([MSBuild]::IsOSPlatform('osx'))">true</IncludeAndroidTarget>
    <IncludeAndroidTarget Condition="'$(IncludeAndroidTarget)' == ''">false</IncludeAndroidTarget>

    <TargetFrameworks Condition="'$(IncludeAndroidTarget)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(TargetFrameworks)' != 'net10.0-ios'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AstraSystemsRental.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>AstraSystems</ApplicationTitle>
    <ApplicationId>app.codalea.astrasystems</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == ''">C:\Program Files\Microsoft\jdk-17.0.20.8-hotspot</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#08090d" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#08090d" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AstraSystemsRental.Contracts\src\AstraSystemsRental.Contracts\AstraSystemsRental.Contracts.csproj" />
  </ItemGroup>

</Project>
