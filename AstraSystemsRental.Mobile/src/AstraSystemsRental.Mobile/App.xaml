<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AstraSystemsRental.Mobile"
             x:Class="AstraSystemsRental.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:StatusColorConverter x:Key="StatusColor" />
            <local:MenuIconConverter x:Key="MenuIcon" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
