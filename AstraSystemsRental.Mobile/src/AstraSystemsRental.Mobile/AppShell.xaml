<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AstraSystemsRental.Mobile"
       xmlns:views="clr-namespace:AstraSystemsRental.Mobile.Views"
       x:Class="AstraSystemsRental.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Bg2}"
       Shell.ForegroundColor="{StaticResource Content}"
       Shell.TitleColor="{StaticResource Content}"
       Shell.TabBarBackgroundColor="{StaticResource Bg2}"
       Shell.TabBarForegroundColor="{StaticResource BrandBright}"
       Shell.TabBarUnselectedColor="{StaticResource ContentMuted}"
       FlyoutBackgroundColor="{StaticResource Bg2}"
       Title="AstraSystems">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="150" BackgroundColor="{StaticResource Bg}">
            <Border Style="{StaticResource BrandOrb}" HorizontalOptions="Start" VerticalOptions="Center"
                    Margin="20,0,0,0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 16">
                <Grid>
                    <Path Data="{x:Static local:Icons.MonogramRing}" Stroke="#59FFFFFF" StrokeThickness="1.4"
                          Fill="Transparent" HeightRequest="32" WidthRequest="32" Aspect="Uniform" Rotation="-20"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Path Data="{x:Static local:Icons.Monogram}" Stroke="White" StrokeThickness="2.1"
                          Fill="Transparent" HeightRequest="24" WidthRequest="24" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>
            <VerticalStackLayout VerticalOptions="Center" Margin="88,0,0,0" Spacing="2">
                <Label Text="AstraSystems" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Content}" />
                <Label Text="Gestión de flota" FontSize="12" TextColor="{StaticResource ContentMuted}" />
            </VerticalStackLayout>
            <Label Text="created by codalea" FontSize="10" TextColor="{StaticResource ContentFaint}"
                   HorizontalOptions="Start" VerticalOptions="End" Margin="22,0,0,12" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- El icono se deriva del titulo con un convertidor: Shell no expone un
         binding directo al FlyoutIcon desde la plantilla sin duplicar recursos. -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="30,*" HeightRequest="52" Padding="20,0">
                <Path Grid.Column="0" Data="{Binding Title, Converter={StaticResource MenuIcon}}"
                      Stroke="{StaticResource BrandBright}" StrokeThickness="1.7" Fill="Transparent"
                      HeightRequest="18" WidthRequest="18" Aspect="Uniform"
                      VerticalOptions="Center" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding Title}" FontSize="14.5" Margin="12,0,0,0"
                       TextColor="{StaticResource Content}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent x:Name="LoginItem"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="login"
                  Shell.NavBarIsVisible="False"
                  Shell.FlyoutItemIsVisible="False" />

    <!-- Las pestañas viven DENTRO de un FlyoutItem: asi el menu lateral siempre
         puede volver aca, en vez de reemplazar la barra y dejar al usuario atrapado. -->
    <FlyoutItem x:Name="MainItem" Title="Inicio" Route="main" Icon="menu_home.png">
        <Tab Title="Panel" Route="dashboard" Icon="tab_dashboard.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Flota" Route="fleet" Icon="tab_fleet.png">
            <ShellContent ContentTemplate="{DataTemplate views:FleetPage}" />
        </Tab>
        <Tab Title="Recorrido" Route="tracking" Icon="tab_tracking.png">
            <ShellContent ContentTemplate="{DataTemplate views:TrackingPage}" />
        </Tab>
        <Tab Title="Taller" Route="reservations" Icon="tab_workshop.png">
            <ShellContent ContentTemplate="{DataTemplate views:ReservationsPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem x:Name="RoutinesItem" Title="Rutinas de Mantenimiento" Route="routines" Icon="menu_routine.png">
        <ShellContent ContentTemplate="{DataTemplate views:RoutinesPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="UsersItem" Title="Usuarios" Route="users" Icon="menu_users.png">
        <ShellContent ContentTemplate="{DataTemplate views:UsersPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="ProfileItem" Title="Mi cuenta" Route="profile" Icon="menu_profile.png">
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

</Shell>
