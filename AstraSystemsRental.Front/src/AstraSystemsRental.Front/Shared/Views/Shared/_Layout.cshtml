@inject ICurrentUser CurrentUser
@{
    var user = CurrentUser.Principal;
}
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "AstraSystemsRental")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dist/app.min.css" asp-append-version="true" />
</head>
<body class="min-h-screen">
    <div id="astra-progress" class="htmx-indicator fixed top-0 left-0 right-0 h-0.5 z-50 bg-gradient-brand animate-pulse"></div>
    <div class="flex min-h-screen" x-data="astraShell()" :class="collapsed ? 'astra-shell-collapsed' : ''">
        <aside class="hidden md:flex shrink-0 flex-col border-r border-white/[0.07] bg-bg-2/60 backdrop-blur-sm transition-[width] duration-200 ease-out"
               :class="collapsed ? 'w-[72px]' : 'w-64'">
            <div class="flex items-center gap-2.5 px-5 h-[68px] border-b border-white/[0.07] overflow-hidden">
                <div class="h-8 w-8 shrink-0 rounded-md bg-gradient-brand shadow-brand flex items-center justify-center">
                    <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2.75 6.75A1.75 1.75 0 0 1 4.5 5h8.75a1.75 1.75 0 0 1 1.75 1.75V15H3.5a.75.75 0 0 1-.75-.75V6.75Z" />
                        <path d="M15 8.5h2.94a1.75 1.75 0 0 1 1.55.94l1.56 3a1.75 1.75 0 0 1 .2.81V15H15V8.5Z" />
                        <circle cx="7" cy="17" r="1.75" />
                        <circle cx="17.5" cy="17" r="1.75" />
                        <path d="M8.75 17H15" />
                    </svg>
                </div>
                <span x-show="!collapsed" x-cloak class="font-display font-semibold text-content whitespace-nowrap">AstraSystems</span>
            </div>
            @await Component.InvokeAsync("Sidebar")
            <button type="button" id="sidebar-toggle" @@click="toggle()"
                    class="astra-sidebar-collapse" :title="collapsed ? 'Expandir menú' : 'Colapsar menú'">
                <svg class="h-4 w-4 shrink-0 transition-transform duration-200" :class="collapsed ? 'rotate-180' : ''"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 6-6 6 6 6" />
                </svg>
                <span x-show="!collapsed" x-cloak class="whitespace-nowrap">Colapsar</span>
            </button>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            <header class="h-[68px] shrink-0 flex items-center justify-between px-6 border-b border-white/[0.07] bg-bg-2/40 backdrop-blur-sm">
                <h1 class="text-lg font-display font-semibold">@(ViewData["Title"] ?? "Panel")</h1>
                <div class="flex items-center gap-4">
                    @await Component.InvokeAsync("CompanyContextSwitcher")
                    <div class="text-right hidden sm:block">
                        <p class="text-sm text-content">@user.Email</p>
                        <p class="text-xs text-content-muted">@user.Role</p>
                    </div>
                    <div class="relative" x-data="{ open: false }">
                        <button @@click="open = !open" class="h-9 w-9 rounded-full bg-gradient-brand text-white text-sm font-semibold">
                            @(user.Email.Length > 0 ? user.Email[0].ToString().ToUpper() : "?")
                        </button>
                        <div x-show="open" @@click.outside="open = false" x-cloak
                             x-transition:enter="transition ease-out duration-150"
                             x-transition:enter-start="opacity-0 -translate-y-1"
                             class="absolute right-0 mt-2 w-52 astra-panel p-1.5 z-20">
                            <div class="px-3 py-2 border-b border-white/[0.06] mb-1">
                                <p class="text-sm text-content truncate">@user.Email</p>
                                <p class="text-xs text-content-muted">@StatusText.Role(user.Role)</p>
                            </div>
                            <a href="/profile" id="menu-profile" class="astra-sidebar-item w-full">
                                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="8" r="4" /><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
                                </svg>
                                Mi cuenta
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="astra-sidebar-item w-full text-left text-danger hover:text-danger">
                                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" />
                                    </svg>
                                    Cerrar sesión
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>
            <main class="flex-1 p-6 overflow-y-auto">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
    <script src="~/js/htmx-progress.js" asp-append-version="true"></script>
    <style>[x-cloak]{display:none!important;}</style>
    <script>
        function astraShell() {
            return {
                collapsed: localStorage.getItem('astra-sidebar-collapsed') === '1',
                toggle() {
                    this.collapsed = !this.collapsed;
                    localStorage.setItem('astra-sidebar-collapsed', this.collapsed ? '1' : '0');
                }
            };
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
