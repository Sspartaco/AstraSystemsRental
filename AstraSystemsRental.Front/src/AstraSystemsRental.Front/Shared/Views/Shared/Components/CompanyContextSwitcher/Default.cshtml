@model IReadOnlyList<AstraSystemsRental.Front.Shared.ViewComponents.CompanyOptionVm>
@{
    var active = Model.FirstOrDefault(c => c.IsActive);
    var currentLabel = active?.CompanyName ?? "Mi flota personal";
}

<div class="relative" x-data="{ open: false }">
    <button @@click="open = !open" type="button"
            class="astra-btn-ghost text-xs px-3 py-2 gap-2">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="7.5" width="18" height="12" rx="1.5" />
            <path d="M7.5 7.5V6a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 16.5 6v1.5" />
        </svg>
        <span class="truncate max-w-[140px]">@currentLabel</span>
    </button>

    <div x-show="open" @@click.outside="open = false" x-cloak
         class="absolute left-0 mt-2 w-64 astra-panel p-1.5 z-30">
        <form asp-controller="CompanyContext" asp-action="SetActive" method="post">
            <input type="hidden" name="companyId" value="" />
            <button type="submit" class="astra-sidebar-item w-full text-left @(active is null ? "active" : "")">
                Mi flota personal
            </button>
        </form>

        @foreach (var company in Model)
        {
            <form asp-controller="CompanyContext" asp-action="SetActive" method="post">
                <input type="hidden" name="companyId" value="@company.CompanyId" />
                <button type="submit" class="astra-sidebar-item w-full text-left @(company.IsActive ? "active" : "")">
                    <span class="truncate">@company.CompanyName</span>
                    @if (company.IsOwner)
                    {
                        <span class="astra-badge bg-brand/15 text-brand-bright ml-auto">Owner</span>
                    }
                </button>
            </form>
        }

        <div class="border-t border-white/[0.07] mt-1.5 pt-1.5">
            <a asp-controller="Companies" asp-action="Index" class="astra-sidebar-item w-full">
                Gestionar compañías
            </a>
        </div>
    </div>
</div>
