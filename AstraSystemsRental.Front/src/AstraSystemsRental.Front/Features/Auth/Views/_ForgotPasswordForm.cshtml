@model ForgotPasswordForm

@if (ViewBag.Sent is true)
{
    <div class="rounded-md border border-accent/30 bg-accent/10 px-4 py-3 text-sm text-accent">
        Si existe una cuenta con ese correo, el enlace de restablecimiento ya va en camino.
    </div>
    <a href="/auth/login" class="astra-btn-ghost w-full mt-4">Volver a iniciar sesión</a>
}
else
{
    <form hx-post="/auth/forgot-password" hx-target="#forgot-container" hx-swap="outerHTML" hx-indicator="#forgot-indicator" hx-disabled-elt="#forgot-submit" class="space-y-4">
        <div>
            <label class="astra-label" for="email">Correo electrónico</label>
            <input class="astra-input" type="email" id="email" name="Email" value="@Model.Email"
                   placeholder="tu@empresa.com" autocomplete="email" required />
        </div>
        <button id="forgot-submit" type="submit" class="astra-btn-primary w-full gap-2">
            <span id="forgot-indicator" class="htmx-indicator">
                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" class="opacity-25" />
                    <path d="M21 12a9 9 0 0 0-9-9" />
                </svg>
            </span>
            <span>Enviar enlace</span>
        </button>
        <a href="/auth/login" class="astra-link text-sm block text-center">Volver a iniciar sesión</a>
    </form>
}
