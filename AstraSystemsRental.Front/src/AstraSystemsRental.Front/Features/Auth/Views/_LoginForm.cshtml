@model LoginForm

<form hx-post="/auth/login" hx-target="#login-container" hx-swap="outerHTML" hx-indicator="#login-indicator" hx-disabled-elt="#login-submit" class="space-y-4">
    @if (ViewBag.Error is string error)
    {
        <div class="astra-alert-error">@error</div>
    }

    <div>
        <label class="astra-label" for="email">Correo electrónico</label>
        <input class="astra-input" type="email" id="email" name="Email" value="@Model.Email"
               placeholder="tu@empresa.com" autocomplete="email" required />
    </div>

    <div>
        <label class="astra-label" for="password">Contraseña</label>
        <input class="astra-input" type="password" id="password" name="Password"
               placeholder="••••••••" autocomplete="current-password" required />
    </div>

    <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-content-soft cursor-pointer">
            <input type="checkbox" name="Remember" value="true"
                   class="rounded border-white/20 bg-bg-2 text-brand focus:ring-brand/30" />
            Recordar sesión
        </label>
        <a href="/auth/forgot-password" class="astra-link text-sm">¿Olvidaste tu contraseña?</a>
    </div>

    <button id="login-submit" type="submit" class="astra-btn-primary w-full gap-2">
        <span id="login-indicator" class="htmx-indicator">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" class="opacity-25" />
                <path d="M21 12a9 9 0 0 0-9-9" />
            </svg>
        </span>
        <span>Iniciar sesión</span>
    </button>
</form>
