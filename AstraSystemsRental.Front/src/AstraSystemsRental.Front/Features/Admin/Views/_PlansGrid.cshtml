@model AstraSystemsRental.Front.Features.Admin.CatalogViewModel

<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
    @foreach (var plan in Model.Plans)
    {
        <div class="astra-panel p-5 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-lg">@plan.Name</h3>
                        <span class="astra-badge bg-brand/15 text-brand-bright">@plan.Code.ToUpper()</span>
                        @if (!plan.IsActive)
                        {
                            <span class="astra-badge bg-content-muted/15 text-content-muted">Inactivo</span>
                        }
                    </div>
                    <p class="text-xs text-content-muted mt-1">@plan.DurationDays días de duración</p>
                </div>
            </div>

            <div class="space-y-2">
                <p class="text-xs text-content-soft uppercase tracking-wide">Nodos incluidos</p>
                @foreach (var node in Model.Nodes)
                {
                    var assigned = plan.Nodes.Contains(node.Key);
                    <form hx-post="/admin/catalog/plan-node" hx-target="#plans-grid" hx-swap="innerHTML"
                          class="flex items-center justify-between rounded-md px-3 py-2 bg-white/[0.02] border border-white/[0.05]">
                        <div class="flex items-center gap-2.5">
                            <svg class="h-4 w-4 text-brand-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                @Html.Raw(node.Icon)
                            </svg>
                            <span class="text-sm text-content">@node.Label</span>
                        </div>
                        <input type="hidden" name="PlanId" value="@plan.Id" />
                        <input type="hidden" name="NodeKey" value="@node.Key" />
                        <input type="hidden" name="Assign" value="@((!assigned).ToString().ToLower())" />
                        <button type="submit" role="switch" aria-checked="@assigned.ToString().ToLower()"
                                class="relative inline-flex h-5 w-9 items-center rounded-full transition @(assigned ? "bg-brand" : "bg-white/10")">
                            <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white transition @(assigned ? "translate-x-4" : "translate-x-1")"></span>
                        </button>
                    </form>
                }
            </div>
        </div>
    }
</div>
