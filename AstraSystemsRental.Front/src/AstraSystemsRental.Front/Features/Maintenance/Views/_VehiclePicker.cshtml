@model AstraSystemsRental.Front.Features.Maintenance.MaintenanceIndexVm

@{
    (string badge, string dot) StatusStyle(string status) => status switch
    {
        "Active" => ("bg-accent/15 text-accent", "bg-accent"),
        "Maintenance" or "Draft" => ("bg-warn/15 text-warn", "bg-warn"),
        "Blocked" or "Inactive" or "Sold" => ("bg-danger/15 text-danger", "bg-danger"),
        _ => ("bg-white/[0.06] text-content-soft", "bg-content-muted")
    };
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="astra-alert-error">@Model.Error</div>
}
else if (Model.Vehicles.Count == 0)
{
    <div class="astra-panel p-10 flex flex-col items-center text-center gap-3">
        <svg class="h-10 w-10 text-content-muted/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5V12l3 1.75" />
        </svg>
        <p class="text-sm text-content-muted">No hay vehículos en tu flota todavía.</p>
        <a href="/vehicle-registry/create" class="astra-btn-primary mt-1">Registrar vehículo</a>
    </div>
}
else
{
    <div id="maintenance-vehicles" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var vehicle in Model.Vehicles)
        {
            var (badgeClass, dotClass) = StatusStyle(vehicle.Status);
            <div class="flex flex-col">
            <a href="/maintenance/vehicle/@vehicle.Id" class="astra-card p-5 flex flex-col gap-4 group hover:border-brand/30 hover:-translate-y-0.5 transition rounded-b-none flex-1">
                <div class="flex items-start justify-between gap-3">
                    <div class="h-10 w-10 rounded-lg bg-gradient-brand flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="8.25" />
                            <path d="M12 7.5V12l3 1.75" />
                        </svg>
                    </div>
                    <span class="astra-badge @badgeClass shrink-0">
                        <span class="h-1.5 w-1.5 rounded-full @dotClass"></span>
                        @StatusText.Vehicle(vehicle.Status)
                    </span>
                </div>

                <div>
                    <p class="font-display text-lg tracking-[0.15em] text-content">@vehicle.PlateNumber</p>
                    <p class="text-sm text-content-soft mt-0.5 truncate">
                        @(string.IsNullOrEmpty(vehicle.Brand) && string.IsNullOrEmpty(vehicle.Line) ? "Sin marca/línea" : $"{vehicle.Brand} {vehicle.Line}")
                    </p>
                </div>

                <div class="flex items-center gap-1.5 text-xs text-brand-bright mt-auto pt-3 border-t border-white/[0.06]">
                    Ver ficha de mantenimiento
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 6 6 6-6 6" />
                    </svg>
                </div>
            </a>
            <a href="/maintenance/vehicle/@vehicle.Id?tab=readings"
               class="astra-quick-action" title="Registrar kilometraje de @vehicle.PlateNumber">
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="8.25" /><path d="M12 7.5V12l3 1.75" />
                </svg>
                Registrar kilometraje
            </a>
            </div>
        }
    </div>
}
