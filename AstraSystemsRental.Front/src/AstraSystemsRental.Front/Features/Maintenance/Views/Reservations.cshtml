@model AstraSystemsRental.Front.Features.Maintenance.ReservationsIndexVm
@{
    ViewData["Title"] = "Reservas de Taller";
    var error = ViewData["Error"] as string;
    var statuses = new[] { "Pending", "InWorkshop", "Ready", "Collected", "Cancelled" };
}

<div class="space-y-6" x-data="{ showForm: false }">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-2xl">Reservas de Taller</h2>
            <p class="text-sm text-content-soft mt-1">Agenda de taller de toda la flota. Programá una reserva eligiendo el vehículo, o abrí su ficha para ver el detalle completo.</p>
        </div>
        <button type="button" @@click="showForm = !showForm" class="astra-btn-primary">
            <span x-show="!showForm">Nueva reserva</span>
            <span x-show="showForm" x-cloak>Cerrar</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="astra-alert-error">@error</div>
    }

    <form method="post" action="/maintenance/reservations" x-show="showForm" x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          class="astra-panel p-5 grid grid-cols-1 sm:grid-cols-2 gap-4" data-astra-submit-spinner>
        <div class="sm:col-span-2">
            <label class="astra-label" for="gr-vehicle">Vehículo *</label>
            <select id="gr-vehicle" name="FleetVehicleId" required class="astra-input">
                <option value="">Seleccioná un vehículo…</option>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <option value="@vehicle.Id">@vehicle.PlateNumber — @vehicle.Brand @vehicle.Line</option>
                }
            </select>
        </div>
        <div>
            <label class="astra-label" for="gr-scheduled">Fecha programada *</label>
            <input id="gr-scheduled" name="ScheduledAtUtc" type="datetime-local" required class="astra-input" />
        </div>
        <div>
            <label class="astra-label" for="gr-end">Fin estimado</label>
            <input id="gr-end" name="ExpectedEndAtUtc" type="datetime-local" class="astra-input" />
        </div>
        <div>
            <label class="astra-label" for="gr-provider">Taller</label>
            <select id="gr-provider" name="ProviderId" class="astra-input">
                <option value="">Sin asignar</option>
                @foreach (var provider in Model.Providers)
                {
                    <option value="@provider.Id">@provider.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="astra-label" for="gr-mileage">Kilometraje al ingresar</label>
            <input id="gr-mileage" name="MileageAtReservation" type="number" min="0" class="astra-input" />
        </div>
        <div class="sm:col-span-2">
            <label class="astra-label" for="gr-notes">Notas</label>
            <input id="gr-notes" name="Notes" type="text" maxlength="1000" class="astra-input" />
        </div>
        <div class="sm:col-span-2 flex items-center justify-between">
            <label class="flex items-center gap-2 text-sm text-content-soft">
                <input name="IsWashOnly" type="checkbox" value="true" class="rounded bg-bg-2 border-white/[0.15]" />
                Solo lavado
            </label>
            <button type="submit" class="astra-btn-primary">Crear reserva</button>
        </div>
    </form>

    <form hx-get="/maintenance/reservations" hx-target="#reservations-grid" hx-swap="innerHTML"
          hx-trigger="change from:select[name=status], change from:select[name=providerId], change from:input[name=from], change from:input[name=to]"
          class="astra-panel p-4 grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div>
            <label class="astra-label" for="fl-status">Estado</label>
            <select id="fl-status" name="status" class="astra-input">
                <option value="">Todos</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(Model.Status == s)">@StatusText.Reservation(s)</option>
                }
            </select>
        </div>
        <div>
            <label class="astra-label" for="fl-provider">Taller</label>
            <select id="fl-provider" name="providerId" class="astra-input">
                <option value="">Todos</option>
                @foreach (var provider in Model.Providers)
                {
                    <option value="@provider.Id" selected="@(Model.ProviderId == provider.Id)">@provider.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="astra-label" for="fl-from">Desde</label>
            <input id="fl-from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="astra-input" />
        </div>
        <div>
            <label class="astra-label" for="fl-to">Hasta</label>
            <input id="fl-to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="astra-input" />
        </div>
    </form>

    <div id="reservations-grid" class="space-y-4">
        @await Html.PartialAsync("_ReservationsGrid", Model)
    </div>
</div>
