@model AstraSystemsRental.Front.Features.Maintenance.RoutinesIndexVm

@{
    string QueryFor(int page)
    {
        var qs = $"page={page}";
        if (!string.IsNullOrWhiteSpace(Model.Search)) qs += $"&search={Uri.EscapeDataString(Model.Search)}";
        return qs;
    }
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="astra-alert-error">@Model.Error</div>
}
else if (Model.Items.Count == 0)
{
    <div class="astra-panel p-10 flex flex-col items-center text-center gap-3">
        <svg class="h-10 w-10 text-content-muted/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 6.75h15" />
            <path d="M4.5 12h15" />
            <path d="M4.5 17.25h9" />
            <circle cx="18" cy="17.25" r="2.25" />
        </svg>
        <p class="text-sm text-content-muted">No hay rutinas creadas todavía.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var routine in Model.Items)
        {
            <a href="/maintenance/routines/@routine.Id" class="astra-card p-5 flex flex-col gap-4 group hover:border-brand/30 hover:-translate-y-0.5 transition">
                <div class="flex items-start justify-between gap-3">
                    <div class="h-10 w-10 rounded-lg bg-gradient-brand flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4.5 6.75h15" />
                            <path d="M4.5 12h15" />
                            <path d="M4.5 17.25h9" />
                            <circle cx="18" cy="17.25" r="2.25" />
                        </svg>
                    </div>
                    <span class="astra-badge @(routine.IsActive ? "bg-accent/15 text-accent" : "bg-white/[0.06] text-content-soft") shrink-0">
                        @(routine.IsActive ? "Activa" : "Inactiva")
                    </span>
                </div>

                <div>
                    <p class="font-display text-lg text-content">@routine.Name</p>
                    <p class="text-sm text-content-soft mt-0.5 truncate">@(string.IsNullOrEmpty(routine.Description) ? "Sin descripción" : routine.Description)</p>
                </div>

                <div class="flex items-center gap-1.5 text-xs text-content-muted mt-auto pt-3 border-t border-white/[0.06]">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    @routine.CreatedAtUtc.ToString("yyyy-MM-dd")
                </div>
            </a>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between pt-2">
            <p class="text-xs text-content-muted">Página @Model.PageNumber de @Model.TotalPages</p>
            <div class="flex items-center gap-1.5">
                <button type="button"
                        class="astra-btn-ghost px-3 py-1.5 text-xs disabled:opacity-40 disabled:cursor-not-allowed"
                        hx-get="/maintenance/routines?@QueryFor(Model.PageNumber - 1)" hx-target="#routines-grid" hx-swap="innerHTML"
                        disabled="@(Model.PageNumber <= 1 ? "disabled" : null)">
                    Anterior
                </button>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    var isActive = p == Model.PageNumber;
                    <button type="button"
                            class="@(isActive ? "astra-btn-primary" : "astra-btn-ghost") px-3 py-1.5 text-xs min-w-[2.25rem]"
                            hx-get="/maintenance/routines?@QueryFor(p)" hx-target="#routines-grid" hx-swap="innerHTML">
                        @p
                    </button>
                }
                <button type="button"
                        class="astra-btn-ghost px-3 py-1.5 text-xs disabled:opacity-40 disabled:cursor-not-allowed"
                        hx-get="/maintenance/routines?@QueryFor(Model.PageNumber + 1)" hx-target="#routines-grid" hx-swap="innerHTML"
                        disabled="@(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                    Siguiente
                </button>
            </div>
        </div>
    }
}
