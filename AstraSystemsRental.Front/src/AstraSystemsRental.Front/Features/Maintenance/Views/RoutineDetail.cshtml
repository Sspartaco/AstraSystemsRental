@model AstraSystemsRental.Front.Features.Maintenance.RoutineDto
@{
    ViewData["Title"] = Model.Name;
    var error = ViewData["Error"] as string;
}

<div class="space-y-5 max-w-4xl mx-auto">
    <div>
        <a href="/maintenance/routines" class="astra-link text-sm">&larr; Rutinas de Mantenimiento</a>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="astra-alert-error">@error</div>
    }

    <div class="astra-panel p-6">
        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <h2 class="text-2xl">@Model.Name</h2>
                <p class="text-sm text-content-soft mt-1">@(string.IsNullOrEmpty(Model.Description) ? "Sin descripción" : Model.Description)</p>
            </div>
            <span class="astra-badge @(Model.IsActive ? "bg-accent/15 text-accent" : "bg-white/[0.06] text-content-soft")">
                @(Model.IsActive ? "Activa" : "Inactiva")
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <form method="post" action="/maintenance/routines/@Model.Id/copy" class="astra-panel p-5 flex flex-col sm:flex-row sm:items-end gap-3" data-astra-submit-spinner>
            <div class="flex-1">
                <label class="astra-label" for="rt-copy-name">Copiar rutina como</label>
                <input id="rt-copy-name" name="newName" type="text" required maxlength="150" class="astra-input" placeholder="Copia de @Model.Name" />
            </div>
            <button type="submit" class="astra-btn-ghost">Copiar</button>
        </form>

        <form method="post" action="/maintenance/routines/@Model.Id/delete" class="astra-panel p-5 flex items-end justify-end" data-astra-submit-spinner>
            <button type="submit" class="astra-btn-ghost text-danger hover:text-danger">Eliminar rutina</button>
        </form>
    </div>

    <div class="astra-panel p-5 space-y-4">
        <h3 class="text-lg">Periodicidades</h3>

        <form method="post" action="/maintenance/routines/@Model.Id/periodicities" class="grid grid-cols-1 sm:grid-cols-4 gap-4" data-astra-submit-spinner>
            <div>
                <label class="astra-label" for="rp-unit">Unidad</label>
                <select id="rp-unit" name="Unit" required class="astra-input">
                    <option value="Kilometers">Kilómetros</option>
                    <option value="Hours">Horas</option>
                    <option value="Days">Días</option>
                </select>
            </div>
            <div>
                <label class="astra-label" for="rp-starts">Inicia en</label>
                <input id="rp-starts" name="StartsAt" type="number" min="0" value="0" required class="astra-input" />
            </div>
            <div>
                <label class="astra-label" for="rp-repeats">Se repite cada</label>
                <input id="rp-repeats" name="RepeatsEvery" type="number" min="1" required class="astra-input" placeholder="5000" />
            </div>
            <div class="flex items-end">
                <button type="submit" class="astra-btn-primary w-full">Agregar</button>
            </div>
        </form>

        @if (Model.Periodicities.Count == 0)
        {
            <p class="text-sm text-content-muted">Sin periodicidades configuradas. Agregá al menos una para poder proyectar el próximo mantenimiento.</p>
        }
        else
        {
            <div id="routine-periodicities" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @foreach (var periodicity in Model.Periodicities)
                {
                    <div class="astra-card p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="font-display text-content">Cada @periodicity.RepeatsEvery.ToString("N0")</span>
                            <span class="astra-badge bg-brand/15 text-brand-bright">@periodicity.Unit</span>
                        </div>
                        <p class="text-xs text-content-muted">Inicia en @periodicity.StartsAt.ToString("N0")</p>

                        @if (periodicity.Concepts.Count > 0)
                        {
                            <ul class="space-y-1 pt-2 border-t border-white/[0.06]">
                                @foreach (var concept in periodicity.Concepts)
                                {
                                    <li class="text-xs text-content-soft flex items-center justify-between gap-2">
                                        <span>@concept.Name</span>
                                        <span class="text-content-muted">@concept.Quantity.ToString("N2")</span>
                                    </li>
                                }
                            </ul>
                        }

                        <form method="post" action="/maintenance/routines/@Model.Id/concepts" class="flex flex-col gap-2 pt-2 border-t border-white/[0.06]" data-astra-submit-spinner>
                            <input type="hidden" name="PeriodicityId" value="@periodicity.Id" />
                            <input name="Name" type="text" required maxlength="150" class="astra-input text-xs py-1.5" placeholder="Concepto (ej. Cambio de aceite)" />
                            <div class="flex gap-2">
                                <input name="Quantity" type="number" step="0.01" min="0" value="1" class="astra-input text-xs py-1.5 w-24" />
                                <button type="submit" class="astra-btn-ghost text-xs flex-1">Agregar concepto</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
