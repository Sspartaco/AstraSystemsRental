{
  "name": "maintenance-routines",
  "baseUrl": "https://localhost:8444",
  "defaultTimeoutMs": 15000,
  "stopOnFailure": false,
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    {
      "action": "goto",
      "url": "/auth/login",
      "description": "=== BLOQUE 1: AUTENTICACIÓN ==="
    },
    { "action": "wait", "selector": "#email" },
    { "action": "fill", "selector": "#email", "value": "${PROBE_USERNAME}" },
    { "action": "fill", "selector": "#password", "value": "${PROBE_PASSWORD}", "secret": true },
    { "action": "click", "selector": "#login-submit" },
    { "action": "wait", "selector": "nav", "state": "visible", "timeoutMs": 15000 },

    {
      "action": "goto",
      "url": "/maintenance/routines",
      "description": "=== BLOQUE 2: CARGA DEL MÓDULO ==="
    },
    { "action": "expect", "selector": "#rt-name", "state": "visible" },
    { "action": "expect", "selector": "#routines-grid", "state": "visible" },

    {
      "action": "eval",
      "script": "console.error('PROBE_INICIO: bloque crear rutina')",
      "description": "=== BLOQUE 3: CREAR RUTINA (camino feliz) ==="
    },
    {
      "action": "eval",
      "script": "window.__probeRoutine = 'Rutina PRB' + Math.floor(Math.random() * 900 + 100); sessionStorage.setItem('__probeRoutine', window.__probeRoutine); console.error('PROBE_NOMBRE_RUTINA: ' + window.__probeRoutine)",
      "description": "sessionStorage sobrevive a goto; window.__x se pierde en cada navegación completa"
    },
    {
      "action": "eval",
      "script": "const el = document.querySelector('#rt-name'); el.value = window.__probeRoutine; el.dispatchEvent(new Event('input', {bubbles:true}))"
    },
    { "action": "fill", "selector": "#rt-description", "value": "Creada por Odiseo" },
    { "action": "click", "selector": "form[action='/maintenance/routines'] button[type=submit]" },
    {
      "action": "wait",
      "selector": "#rp-unit",
      "state": "visible",
      "timeoutMs": 15000,
      "description": "Tras crear se redirige al detalle de la rutina (Post-Redirect-Get)"
    },
    {
      "action": "eval",
      "script": "window.__probeRoutineUrl = window.location.pathname; sessionStorage.setItem('__probeRoutineUrl', window.__probeRoutineUrl); console.error('PROBE_URL_RUTINA: ' + window.__probeRoutineUrl)"
    },

    {
      "action": "eval",
      "script": "console.error('PROBE_INICIO: bloque periodicidad y concepto')",
      "description": "=== BLOQUE 4: PERIODICIDAD + CONCEPTO ==="
    },
    { "action": "select", "selector": "#rp-unit", "value": "Kilometers" },
    { "action": "fill", "selector": "#rp-starts", "value": "0" },
    { "action": "fill", "selector": "#rp-repeats", "value": "5000" },
    { "action": "click", "selector": "form[action*='/periodicities'] button[type=submit]" },
    { "action": "wait", "selector": "#routine-periodicities", "state": "visible", "timeoutMs": 15000 },
    {
      "action": "eval",
      "script": "console.error('PROBE_PERIODICIDAD_CREADA: ' + document.querySelector('#routine-periodicities').textContent.includes('5.000'))"
    },
    {
      "action": "eval",
      "script": "const form = document.querySelector('form[action*=\"/concepts\"]'); form.querySelector('input[name=Name]').value = 'Cambio de aceite'; form.querySelector('input[name=Name]').dispatchEvent(new Event('input', {bubbles:true}))"
    },
    { "action": "click", "selector": "form[action*='/concepts'] button[type=submit]" },
    { "action": "wait", "selector": "#routine-periodicities", "state": "visible", "timeoutMs": 15000 },
    {
      "action": "eval",
      "script": "console.error('PROBE_CONCEPTO_CREADO: ' + document.querySelector('#routine-periodicities').textContent.includes('Cambio de aceite'))"
    },

    {
      "action": "eval",
      "script": "console.error('PROBE_INICIO: bloque nombre duplicado')",
      "description": "=== BLOQUE 5: RECHAZO DE NOMBRE DUPLICADO ==="
    },
    { "action": "goto", "url": "/maintenance/routines" },
    { "action": "wait", "selector": "#rt-name", "state": "visible", "timeoutMs": 10000 },
    {
      "action": "eval",
      "script": "window.__probeRoutine = window.__probeRoutine || sessionStorage.getItem('__probeRoutine'); const el = document.querySelector('#rt-name'); el.value = window.__probeRoutine; el.dispatchEvent(new Event('input', {bubbles:true}))"
    },
    { "action": "click", "selector": "form[action='/maintenance/routines'] button[type=submit]" },
    {
      "action": "wait",
      "selector": ".astra-alert-error",
      "state": "visible",
      "timeoutMs": 10000,
      "description": "El backend rechaza el duplicado (UX_MaintenanceRoutines_Owner_Name) y el Front lo muestra vía TempData + PRG"
    },

    {
      "action": "eval",
      "script": "console.error('PROBE_INICIO: bloque copiar rutina')",
      "description": "=== BLOQUE 6: COPIAR RUTINA ==="
    },
    {
      "action": "eval",
      "script": "window.__probeRoutineUrl = window.__probeRoutineUrl || sessionStorage.getItem('__probeRoutineUrl'); const card = [...document.querySelectorAll('#routines-grid a[href^=\"/maintenance/routines/\"]')].find(a => a.getAttribute('href') === window.__probeRoutineUrl); if (!card) throw new Error('Card de rutina no encontrada'); card.click(); console.error('PROBE_ABRIR_RUTINA: ok')"
    },
    { "action": "wait", "selector": "#rt-copy-name", "state": "visible", "timeoutMs": 10000 },
    {
      "action": "eval",
      "script": "window.__probeRoutineCopy = 'Copia PRB' + Math.floor(Math.random() * 900 + 100); sessionStorage.setItem('__probeRoutineCopy', window.__probeRoutineCopy); const el = document.querySelector('#rt-copy-name'); el.value = window.__probeRoutineCopy; el.dispatchEvent(new Event('input', {bubbles:true}))"
    },
    { "action": "click", "selector": "form[action*='/copy'] button[type=submit]" },
    { "action": "wait", "selector": "#routines-grid", "state": "visible", "timeoutMs": 15000 },
    {
      "action": "eval",
      "script": "window.__probeRoutineCopy = window.__probeRoutineCopy || sessionStorage.getItem('__probeRoutineCopy'); console.error('PROBE_COPIA_EN_LISTA: ' + document.querySelector('#routines-grid').textContent.includes(window.__probeRoutineCopy))"
    },

    {
      "action": "eval",
      "script": "console.error('PROBE_INICIO: bloque eliminar rutina copiada')",
      "description": "=== BLOQUE 7: ELIMINAR ==="
    },
    {
      "action": "eval",
      "script": "window.__probeRoutineCopy = window.__probeRoutineCopy || sessionStorage.getItem('__probeRoutineCopy'); const card = [...document.querySelectorAll('#routines-grid a[href^=\"/maintenance/routines/\"]')].find(a => a.textContent.includes(window.__probeRoutineCopy)); if (!card) throw new Error('Copia no encontrada'); card.click()"
    },
    { "action": "wait", "selector": "form[action*='/delete'] button[type=submit]", "state": "visible", "timeoutMs": 10000 },
    { "action": "click", "selector": "form[action*='/delete'] button[type=submit]" },
    { "action": "wait", "selector": "#routines-grid", "state": "visible", "timeoutMs": 15000 },
    {
      "action": "eval",
      "script": "window.__probeRoutineCopy = window.__probeRoutineCopy || sessionStorage.getItem('__probeRoutineCopy'); console.error('PROBE_COPIA_ELIMINADA: ' + (!document.querySelector('#routines-grid').textContent.includes(window.__probeRoutineCopy)))"
    }
  ]
}
