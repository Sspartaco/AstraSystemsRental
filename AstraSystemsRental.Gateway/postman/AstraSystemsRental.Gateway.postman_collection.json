{
  "info": {
    "name": "AstraSystemsRental.Gateway",
    "description": "Gateway — single entry point. Validates JWT, subscription window and node access before proxying to the APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}/health",
          "host": ["{{gatewayBaseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Proxied protected call (needs token + node)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Astra-Node", "value": "dashboard" }
        ],
        "url": {
          "raw": "{{gatewayBaseUrl}}/apiUsers/users/me",
          "host": ["{{gatewayBaseUrl}}"],
          "path": ["apiUsers", "users", "me"]
        }
      }
    }
  ],
  "variable": [
    { "key": "gatewayBaseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" }
  ]
}
